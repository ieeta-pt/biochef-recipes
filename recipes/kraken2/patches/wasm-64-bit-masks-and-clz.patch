         opts.taxonomy_filename = optarg;
         break;
       case 'S' :
-        opts.spaced_seed_mask = strtol(optarg, nullptr, 2);
+        opts.spaced_seed_mask = strtoll(optarg, nullptr, 2);
         break;
       case 'T' :
-        opts.toggle_mask = strtol(optarg, nullptr, 2);
+        opts.toggle_mask = strtoll(optarg, nullptr, 2);
         break;
       case 'k' :
