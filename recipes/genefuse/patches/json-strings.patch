The JSON report holds the command line, the genes' names and the reads'
qualities, which can hold '"' and '\', as JSON strings.

diff --git a/src/biochef_genefuse.h b/src/biochef_genefuse.h
new file mode 100644
index 0000000..f59a00c
--- /dev/null
+++ b/src/biochef_genefuse.h
@@ -0,0 +1,23 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string>
+
+// A string as a JSON string's contents
+static inline std::string biochef_json(const std::string &s)
+{
+	std::string out;
+	for (size_t i = 0; i < s.size(); i++) {
+		unsigned char c = s[i];
+		if (c == '"' || c == '\\') {
+			out += '\\';
+			out += (char)c;
+		} else if (c < 0x20) {
+			char u[8];
+			snprintf(u, sizeof u, "\\u%04x", c);
+			out += u;
+		} else {
+			out += (char)c;
+		}
+	}
+	return out;
+}
