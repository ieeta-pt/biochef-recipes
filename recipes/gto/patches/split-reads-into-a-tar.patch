 #include "buffer.h"
 #include "argparse.h"
 #include <unistd.h>
+#include <errno.h>
+#include <sys/stat.h>
+
+// BioChef: --bc-parts writes the files into one tar instead of a directory,
+// since an operation's output is one file. The members are out1.fasta,
+// out2.fasta and so on, in order, owned by nobody and dated 0.
+static void PutOctal(char *field, size_t width, unsigned long long value)
+{
+  snprintf(field, width, "%0*llo", (int) width - 1, value);
+}
+
+// Removes the files written so far and the directory they went in
+static void RemoveParts(const char *dir, uint32_t count)
+{
+  char path[128];
+  for(uint32_t n = 1 ; n <= count ; ++n)
+  {
+    sprintf(path, "%s/out%u.fasta", dir, n);
+    remove(path);
+  }
+  rmdir(dir);
+}
+
+static void TarMember(FILE *tar, const char *name, const char *path)
+{
+  char header[512];
+  struct stat st;
+  FILE *in;
+  if(stat(path, &st) || !(in = fopen(path, "rb")))
+  {
+    fprintf(stderr, "Error: cannot read %s\n", path);
+    exit(1);
+  }
+  memset(header, 0, sizeof header);
+  strncpy(header, name, 100);
+  PutOctal(header + 100, 8, 0644);
+  PutOctal(header + 108, 8, 0);
+  PutOctal(header + 116, 8, 0);
+  PutOctal(header + 124, 12, (unsigned long long) st.st_size);
+  PutOctal(header + 136, 12, 0);
+  header[156] = '0';
+  memcpy(header + 257, "ustar", 6);
+  memcpy(header + 263, "00", 2);
+  memset(header + 148, ' ', 8);
+  unsigned sum = 0;
+  for(int i = 0 ; i < 512 ; ++i)
+    sum += (unsigned char) header[i];
+  snprintf(header + 148, 8, "%06o", sum);
+  fwrite(header, 1, 512, tar);
+  // static: a 64 KiB frame would be the whole of a wasm build's stack
+  static char buf[65536];
+  size_t n;
+  while((n = fread(buf, 1, sizeof buf, in)) > 0)
+    fwrite(buf, 1, n, tar);
+  fclose(in);
+  static const char zeros[512] = { 0 };
+  size_t pad = (512 - st.st_size % 512) % 512;
+  fwrite(zeros, 1, pad, tar);
+}
 
