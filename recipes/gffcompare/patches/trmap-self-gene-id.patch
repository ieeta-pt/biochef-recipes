-	if (selfMap) geneAdd(genes, d.t->getGeneName());
+	if (selfMap && (d.t->getGeneName() || d.t->getGeneID())) geneAdd(genes, d.t->getGeneName() ? d.t->getGeneName() : d.t->getGeneID());
