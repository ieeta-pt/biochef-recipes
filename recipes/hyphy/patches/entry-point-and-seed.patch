+
+// The entry point of HyPhy: it reads a FASTA alignment first and refuses
+// what HyPhy would read without a word, such as sequences of different
+// lengths, seeds HyPhy's random numbers with --bc-seed (1 by default), and
+// natively finds HyPhy's batch files next to the executable, or in it.
+#include <errno.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <set>
+#include <string>
+#include <vector>
+#if defined(__APPLE__)
+#include <mach-o/dyld.h>
+#endif
+
+extern "C" { long biochef_random_seed = 1; }
+
+static void biochef_fail(const char *format, ...)
+{
+	va_list ap;
+	va_start(ap, format);
+	fputs("[hyphy] ", stderr);
+	vfprintf(stderr, format, ap);
+	fputc('\n', stderr);
+	va_end(ap);
+	exit(1);
+}
+
+static std::string biochef_shown(int c)
+{
+	char s[8];
+	if (c >= 33 && c <= 126) snprintf(s, sizeof s, "'%c'", c);
+	else snprintf(s, sizeof s, "0x%02X", c);
+	return s;
+}
+
+// The codon analyses the recipe runs, which need whole codons
+static bool biochef_codon_analysis(const char *name)
+{
+	static const char *const codon[] = { "BUSTED", "MEME", "FEL", "aBSREL", NULL };
+	for (const char *const *c = codon; *c; c++)
+		if (!strcmp(name, *c)) return true;
+	return false;
+}
+
+// Reads a FASTA alignment as HyPhy does: a sequence's name is its whole
+// header line
+static void biochef_check_alignment(const char *path, bool codons)
+{
+	FILE *in = fopen(path, "rb");
+	if (!in) biochef_fail("cannot open the alignment %s (%s)", path, strerror(errno));
+	int c = getc(in);
+	while (c == ' ' || c == '\t' || c == '\r' || c == '\n') c = getc(in);
+	if (c != '>') {
+		fclose(in);
+		return; // NEXUS, PHYLIP and the other formats HyPhy reads itself
+	}
+	ungetc(c, in);
+	std::set<std::string> names;
+	std::vector<std::string> order;
+	std::vector<long> lengths;
+	std::string line, name;
+	long number = 0;
+	bool done = false;
+	while (!done) {
+		line.clear();
+		while ((c = getc(in)) != EOF && c != '\n') line += (char)c;
+		if (c == EOF) {
+			done = true;
+			if (line.empty()) break;
+		}
+		number++;
+		if (!line.empty() && line[line.size() - 1] == '\r') line.erase(line.size() - 1);
+		if (memchr(line.data(), 0, line.size())) biochef_fail("line %ld of the alignment %s holds a NUL byte", number, path);
+		// HyPhy reads a tree after the sequences as the alignment's tree
+		if (!line.empty() && line[0] == '(' && !order.empty()) break;
+		if (!line.empty() && line[0] == '>') {
+			name = line.substr(1);
+			if (name.find_first_not_of(" \t") == std::string::npos) biochef_fail("line %ld of the alignment %s starts a sequence with no name", number, path);
+			if (!names.insert(name).second) biochef_fail("the alignment %s has two sequences named %s", path, name.c_str());
+			order.push_back(name);
+			lengths.push_back(0);
+			continue;
+		}
+		for (size_t i = 0; i < line.size(); i++) {
+			unsigned char b = line[i];
+			if (b == ' ' || b == '\t') continue;
+			if (!((b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') || b == '-' || b == '?' || b == '.'))
+				biochef_fail("line %ld of the alignment %s has %s in sequence %s", number, path, biochef_shown(b).c_str(), name.c_str());
+			lengths.back()++;
+		}
+	}
+	fclose(in);
+	if (order.size() < 2) biochef_fail("the alignment %s holds %zu sequence%s: it needs at least two", path, order.size(), order.size() == 1 ? "" : "s");
+	for (size_t i = 0; i < order.size(); i++) {
+		if (!lengths[i]) biochef_fail("sequence %s of the alignment %s has no bases", order[i].c_str(), path);
+		if (lengths[i] != lengths[0])
+			biochef_fail("sequence %s of the alignment %s has %ld columns and sequence %s %ld: the sequences of an alignment are all as long", order[i].c_str(), path, lengths[i], order[0].c_str(), lengths[0]);
+	}
+	if (codons && lengths[0] % 3)
+		biochef_fail("the alignment %s has %ld columns, which is not a whole number of codons", path, lengths[0]);
+}
+
+
+#ifdef BIOCHEF_EMBEDDED_RES
+// HyPhy's batch files, a tar of res/ linked into the executable: the hub
+// ships one file for a native operation
+extern "C" const unsigned char biochef_res_tar[], biochef_res_tar_end[];
+static std::string biochef_res_dir;
+
+static void biochef_remove_tree(const std::string &path)
+{
+	struct stat st;
+	if (lstat(path.c_str(), &st) != 0) return;
+	if (S_ISDIR(st.st_mode)) {
+		DIR *d = opendir(path.c_str());
+		if (d) {
+			std::vector<std::string> names;
+			for (struct dirent *e; (e = readdir(d));)
+				if (strcmp(e->d_name, ".") && strcmp(e->d_name, "..")) names.push_back(e->d_name);
+			closedir(d);
+			for (size_t i = 0; i < names.size(); i++) biochef_remove_tree(path + "/" + names[i]);
+		}
+		rmdir(path.c_str());
+	} else {
+		unlink(path.c_str());
+	}
+}
+
+static void biochef_remove_res(void)
+{
+	if (!biochef_res_dir.empty()) biochef_remove_tree(biochef_res_dir);
+}
+
+// Writes the embedded tar's directories and files under a new temporary
+// directory, and returns it
+static std::string biochef_extract_res(void)
+{
+	const char *tmp = getenv("TMPDIR");
+	std::string base = std::string(tmp && *tmp ? tmp : "/tmp") + "/hyphy-res.XXXXXX";
+	std::vector<char> templ(base.begin(), base.end());
+	templ.push_back(0);
+	if (!mkdtemp(&templ[0])) biochef_fail("cannot make a directory for HyPhy's batch files (%s)", strerror(errno));
+	biochef_res_dir = &templ[0];
+	atexit(biochef_remove_res);
+	const unsigned char *p = biochef_res_tar, *end = biochef_res_tar_end;
+	while (p + 512 <= end && p[0]) {
+		char name[101] = { 0 }, size[13] = { 0 };
+		memcpy(name, p, 100);
+		memcpy(size, p + 124, 12);
+		unsigned long n = strtoul(size, NULL, 8);
+		char type = (char)p[156];
+		std::string rel = name;
+		if (rel.empty() || rel[0] == '/' || rel.find("..") != std::string::npos || p + 512 + n > end)
+			biochef_fail("HyPhy's embedded batch files are damaged");
+		std::string path = biochef_res_dir + "/" + rel;
+		if (type == '5') {
+			mkdir(path.c_str(), 0700);
+		} else if (type == '0' || type == 0) {
+			FILE *f = fopen(path.c_str(), "wb");
+			if (!f || fwrite(p + 512, 1, n, f) != n || fclose(f) != 0) biochef_fail("cannot write %s (%s)", path.c_str(), strerror(errno));
+		}
+		p += 512 + ((n + 511) / 512) * 512;
+	}
+	return biochef_res_dir + "/res/";
+}
+#endif
+
+int main(int argc, char *argv[])
+{
+	std::vector<char *> args(1, argv[0]);
+	bool libpath = false;
+	const char *analysis = NULL, *alignment = NULL;
+	for (int i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--bc-seed")) {
+			char *end;
+			errno = 0;
+			if (i + 1 >= argc) biochef_fail("--bc-seed needs a whole number");
+			long long v = strtoll(argv[i + 1], &end, 10);
+			if (!*argv[i + 1] || *end || errno || v < 0 || v > INT_MAX) biochef_fail("--bc-seed should be a whole number from 0 to %d, and is \"%s\"", INT_MAX, argv[i + 1]);
+			biochef_random_seed = (long)v;
+			i++;
+			continue;
+		}
+		if (!strncmp(argv[i], "LIBPATH=", 8)) libpath = true;
+		if (!strncmp(argv[i], "--", 2) && i + 1 < argc) {
+			// HyPhy's keyword arguments, --name value
+			if (!strcmp(argv[i], "--alignment")) alignment = argv[i + 1];
+			args.push_back(argv[i]);
+			args.push_back(argv[++i]);
+			continue;
+		}
+		if (!analysis && argv[i][0] != '-' && !strchr(argv[i], '=')) analysis = argv[i];
+		args.push_back(argv[i]);
+	}
+	if (alignment) biochef_check_alignment(alignment, analysis && biochef_codon_analysis(analysis));
+#ifndef __EMSCRIPTEN__
+	// HyPhy's batch files are in res/, next to the executable
+	static std::string lib;
+	if (!libpath) {
+		char exe[PATH_MAX + 1] = { 0 };
+#if defined(__APPLE__)
+		uint32_t size = sizeof exe;
+		char raw[PATH_MAX + 1];
+		if (_NSGetExecutablePath(raw, &size) != 0 || !realpath(raw, exe)) exe[0] = 0;
+#else
+		ssize_t n = readlink("/proc/self/exe", exe, PATH_MAX);
+		if (n <= 0) exe[0] = 0;
+		else exe[n] = 0;
+#endif
+		char *slash = strrchr(exe, '/');
+		if (slash) {
+			*slash = 0;
+			std::string res = std::string(exe) + "/res/";
+			struct stat st;
+			if (stat(res.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) lib = "LIBPATH=" + res;
+		}
+#ifdef BIOCHEF_EMBEDDED_RES
+		if (lib.empty()) lib = "LIBPATH=" + biochef_extract_res();
+#endif
+		if (!lib.empty()) args.insert(args.begin() + 1, (char *)lib.c_str());
+	}
+#endif
+	args.push_back(NULL);
+	return biochef_upstream_main((int)args.size() - 1, &args[0]);
+}
