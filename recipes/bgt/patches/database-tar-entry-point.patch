A BGT database is four files sharing a prefix, which BioChef passes from one
operation to the next as one tar. This entry point, linked in place of bgt's
own main, writes that tar after import and checks and unpacks it before the
operations that read a database.

diff --git a/biochef_main.c b/biochef_main.c
new file mode 100644
index 0000000..172bddb
--- /dev/null
+++ b/biochef_main.c
@@ -0,0 +1,444 @@
+#include <limits.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+int bgt_main(int argc, char *argv[]);
+
+/* A BGT database is four files sharing a prefix. Between operations it
+ * travels as one tar holding them under the prefix "bgt", so that a single
+ * input carries the whole database and it can be unpacked outside BioChef. */
+static const char *members[] = { "bgt.bcf", "bgt.bcf.csi", "bgt.pbf", "bgt.spl", NULL };
+#define N_MEMBERS 4
+#define OUT_PREFIX "_bc_bgt"
+#define MAX_STORES 8
+
+static void fail(const char *format, ...) __attribute__((noreturn, format(printf, 1, 2)));
+static void fail(const char *format, ...)
+{
+	va_list ap;
+	fputs("[bgt] ", stderr);
+	va_start(ap, format);
+	vfprintf(stderr, format, ap);
+	va_end(ap);
+	fputc('\n', stderr);
+	exit(1);
+}
+
+static void *xmalloc(size_t size)
+{
+	void *p = malloc(size ? size : 1);
+	if (!p) fail("out of memory");
+	return p;
+}
+
+static unsigned char *read_file(const char *path, long *size)
+{
+	FILE *fp = fopen(path, "rb");
+	unsigned char *buf;
+	if (!fp) fail("cannot read %s", path);
+	if (fseek(fp, 0, SEEK_END) || (*size = ftell(fp)) < 0 || fseek(fp, 0, SEEK_SET)) fail("cannot read %s", path);
+	buf = xmalloc(*size + 1);
+	if (fread(buf, 1, *size, fp) != (size_t)*size) fail("cannot read %s", path);
+	buf[*size] = 0;
+	fclose(fp);
+	return buf;
+}
+
+static void write_file(const char *path, const void *data, long size)
+{
+	FILE *fp = fopen(path, "wb");
+	if (!fp || fwrite(data, 1, size, fp) != (size_t)size || fclose(fp)) fail("cannot write %s", path);
+}
+
+static uint32_t le32(const unsigned char *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* ---- tar (POSIX ustar), only regular files ---- */
+
+static unsigned tar_checksum(const unsigned char *h)
+{
+	unsigned sum = 0;
+	int i;
+	for (i = 0; i < 512; ++i) sum += (i >= 148 && i < 156) ? ' ' : h[i];
+	return sum;
+}
+
+/* Writes the files as a tar with fixed owner, mode and time, so the same
+ * database always gives the same bytes. */
+static void tar_write(const char *path, const char *prefix)
+{
+	FILE *out = fopen(path, "wb");
+	static unsigned char zero[1024];
+	int i;
+	if (!out) fail("cannot write %s", path);
+	for (i = 0; members[i]; ++i) {
+		unsigned char h[512];
+		char name[64];
+		long size, pad;
+		unsigned char *data;
+		snprintf(name, sizeof name, "%s%s", prefix, members[i] + 3);
+		data = read_file(name, &size);
+		memset(h, 0, sizeof h);
+		memcpy(h, members[i], strlen(members[i]));
+		memcpy(h + 100, "0000644", 7);
+		memcpy(h + 108, "0000000", 7);
+		memcpy(h + 116, "0000000", 7);
+		snprintf((char *)h + 124, 12, "%011lo", size);
+		memcpy(h + 136, "00000000000", 11);
+		h[156] = '0';
+		memcpy(h + 257, "ustar", 6);
+		memcpy(h + 263, "00", 2);
+		snprintf((char *)h + 148, 8, "%06o", tar_checksum(h));
+		h[155] = ' ';
+		pad = (512 - size % 512) % 512;
+		if (fwrite(h, 1, 512, out) != 512 || fwrite(data, 1, size, out) != (size_t)size
+		    || fwrite(zero, 1, pad, out) != (size_t)pad)
+			fail("cannot write %s", path);
+		free(data);
+	}
+	if (fwrite(zero, 1, 1024, out) != 1024 || fclose(out)) fail("cannot write %s", path);
+}
+
+static long octal(const unsigned char *p, int len, const char *path)
+{
+	long v = 0;
+	int i = 0;
+	while (i < len && p[i] == ' ') ++i;
+	if (i == len || p[i] < '0' || p[i] > '7') fail("%s is not a BGT database: a broken tar header", path);
+	for (; i < len && p[i] >= '0' && p[i] <= '7'; ++i) {
+		if (v > (LONG_MAX - 7) / 8) fail("%s is not a BGT database: a member is too large", path);
+		v = v * 8 + (p[i] - '0');
+	}
+	for (; i < len; ++i)
+		if (p[i] != ' ' && p[i] != 0) fail("%s is not a BGT database: a broken tar header", path);
+	return v;
+}
+
+/* A pax header (typeflag x or g) may carry attributes such as times or
+ * extended attributes, which do not matter here. One that renames the next
+ * member or changes its size would make it a different file: refused. */
+static void check_pax(const unsigned char *p, long len, const char *path)
+{
+	const unsigned char *end = p + len;
+	while (p < end && *p) {
+		long n = 0;
+		const unsigned char *q = p, *key;
+		while (q < end && *q >= '0' && *q <= '9' && n < len) n = n * 10 + (*q++ - '0');
+		if (q == p || q >= end || *q != ' ' || n <= q - p + 1 || n > end - p || p[n - 1] != '\n')
+			fail("%s is not a BGT database: a broken pax header", path);
+		key = q + 1;
+		if (!strncmp((const char *)key, "path=", 5) || !strncmp((const char *)key, "linkpath=", 9)
+		    || !strncmp((const char *)key, "size=", 5) || !strncmp((const char *)key, "GNU.sparse", 10))
+			fail("%s is not a BGT database: a pax header changes a member", path);
+		p += n;
+	}
+}
+
+struct store { const unsigned char *data[N_MEMBERS]; long size[N_MEMBERS]; unsigned char *buf; };
+
+/* Reads a tar that must hold exactly the four members of a database, each
+ * once, as regular files. Nothing in it names a path. */
+static void tar_read(const char *path, struct store *s)
+{
+	long size, off = 0;
+	int i, found = 0;
+	memset(s, 0, sizeof *s);
+	s->buf = read_file(path, &size);
+	for (;;) {
+		const unsigned char *h = s->buf + off;
+		long len;
+		if (off + 512 > size) fail("%s is not a BGT database: it ends inside a tar header", path);
+		for (i = 0; i < 512 && !h[i]; ++i);
+		if (i == 512) break;
+		if (memcmp(h + 257, "ustar", 5)) fail("%s is not a BGT database: not a tar file", path);
+		if (octal(h + 148, 8, path) != (long)tar_checksum(h)) fail("%s is not a BGT database: a tar header checksum is wrong", path);
+		if (h[156] == 'x' || h[156] == 'g') {
+			len = octal(h + 124, 12, path);
+			if (len > size - off - 512) fail("%s is not a BGT database: a pax header is cut short", path);
+			check_pax(h + 512, len, path);
+			off += 512 + (len + 511) / 512 * 512;
+			continue;
+		}
+		if (h[156] != '0' && h[156] != 0) fail("%s is not a BGT database: it holds something other than files", path);
+		if (h[345]) fail("%s is not a BGT database: a member has a path", path);
+		len = octal(h + 124, 12, path);
+		if (len > size - off - 512) fail("%s is not a BGT database: %.100s is cut short", path, (const char *)h);
+		/* macOS tar adds the extended attributes of a file as ._file */
+		for (i = 0; members[i]; ++i)
+			if (!strncmp((const char *)h, "._", 2) && !strncmp((const char *)h + 2, members[i], 98) && !h[2 + strlen(members[i])]) break;
+		if (members[i]) {
+			off += 512 + (len + 511) / 512 * 512;
+			continue;
+		}
+		for (i = 0; members[i]; ++i)
+			if (!strncmp((const char *)h, members[i], 100) && !h[strlen(members[i])]) break;
+		if (!members[i]) fail("%s is not a BGT database: it holds %.100s", path, (const char *)h);
+		if (found & 1 << i) fail("%s is not a BGT database: it holds %s twice", path, members[i]);
+		found |= 1 << i;
+		s->data[i] = h + 512;
+		s->size[i] = len;
+		off += 512 + (len + 511) / 512 * 512;
+	}
+	for (i = 0; members[i]; ++i)
+		if (!(found & 1 << i)) fail("%s is not a BGT database: it lacks %s", path, members[i]);
+}
+
+/* The samples, one per line of bgt.spl: the name, then its metadata. */
+static int count_samples(const struct store *s, const char *path)
+{
+	const unsigned char *p = s->data[3], *end = p + s->size[3];
+	int n = 0;
+	while (p < end) {
+		const unsigned char *eol = memchr(p, '\n', end - p);
+		if (!eol) eol = end;
+		if (eol > p) {
+			if (*p == '\t' || memchr(p, 0, eol - p)) fail("%s is not a BGT database: a sample without a name", path);
+			++n;
+		}
+		p = eol + 1;
+	}
+	return n;
+}
+
+/* The members must belong together: the genotype matrix has two columns
+ * per sample and its index is inside the file, and both BCF files are
+ * BGZF. Upstream bgt trusts these numbers when it reads the matrix. */
+static void check_store(const struct store *s, const char *path)
+{
+	static const unsigned char bgzf[] = { 0x1f, 0x8b, 0x08, 0x04 };
+	const unsigned char *pbf = s->data[2];
+	long size = s->size[2];
+	uint64_t trailer = 0;
+	int i, n = count_samples(s, path);
+	if (n < 1) fail("%s is not a BGT database: it has no samples", path);
+	if (s->size[0] < 28 || memcmp(s->data[0], bgzf, 4)) fail("%s is not a BGT database: bgt.bcf is not BGZF", path);
+	if (s->size[1] < 28 || memcmp(s->data[1], bgzf, 4)) fail("%s is not a BGT database: bgt.bcf.csi is not BGZF", path);
+	if (size < 16 + 8 || memcmp(pbf, "PBF\1", 4)) fail("%s is not a BGT database: bgt.pbf is not a genotype matrix", path);
+	if (le32(pbf + 4) != 2u * n || le32(pbf + 8) != 2)
+		fail("%s is not a BGT database: bgt.pbf has %u columns for %d samples", path, le32(pbf + 4), n);
+	for (i = 7; i >= 0; --i) trailer = trailer << 8 | pbf[size - 8 + i];
+	if (trailer < 16 || trailer > (uint64_t)size - 8 - 13) fail("%s is not a BGT database: bgt.pbf is cut short", path);
+	{
+		uint32_t n_idx = le32(pbf + trailer + 9);
+		if ((uint64_t)n_idx * 8 > (uint64_t)size - 8 - trailer - 13)
+			fail("%s is not a BGT database: bgt.pbf is cut short", path);
+	}
+}
+
+static void unpack(const char *path, const char *prefix)
+{
+	struct store s;
+	int i;
+	tar_read(path, &s);
+	check_store(&s, path);
+	for (i = 0; members[i]; ++i) {
+		char name[64];
+		snprintf(name, sizeof name, "%s%s", prefix, members[i] + 3);
+		write_file(name, s.data[i], s.size[i]);
+	}
+	free(s.buf);
+}
+
+/* ---- sample metadata ---- */
+
+static int valid_meta(const char *field)
+{
+	const char *c = strchr(field, ':');
+	return c && c > field && (c[1] == 'Z' || c[1] == 'f' || c[1] == 'i') && c[2] == ':';
+}
+
+/* Replaces the samples of a database with the same samples carrying the
+ * metadata of an FMF file: one line per sample, its name, then fields
+ * key:type:value. bgt matches samples to genotype columns by line, so the
+ * lines are written in the database's order, and every name must be one
+ * of its samples. Samples the file leaves out keep no metadata. */
+static void set_samples(const char *store_path, const char *fmf_path, const char *out_path)
+{
+	struct store s;
+	long fsize, i;
+	unsigned char *fmf = read_file(fmf_path, &fsize);
+	char **names, **meta, *p, *line, *spl;
+	int n, j, k, nlines = 0;
+	size_t total = 0;
+
+	tar_read(store_path, &s);
+	check_store(&s, store_path);
+	n = count_samples(&s, store_path);
+	names = calloc(n, sizeof *names);
+	meta = calloc(n, sizeof *meta);
+	if (!names || !meta) fail("out of memory");
+	spl = xmalloc(s.size[3] + 1);
+	memcpy(spl, s.data[3], s.size[3]);
+	spl[s.size[3]] = 0;
+	for (j = 0, line = strtok(spl, "\n"); line; line = strtok(NULL, "\n")) {
+		line[strcspn(line, "\t\r")] = 0;
+		for (k = 0; k < j; ++k)
+			if (!strcmp(names[k], line)) fail("%s is not a BGT database: sample %s is there twice", store_path, line);
+		names[j++] = line;
+	}
+
+	for (i = 0; i < fsize; ++i)
+		if (!fmf[i]) fail("%s is not sample metadata: it holds a NUL byte", fmf_path);
+	for (p = (char *)fmf; *p; ) {
+		char *eol = p + strcspn(p, "\n"), *name, *f;
+		int last = !*eol;
+		*eol = 0;
+		if (eol > p && eol[-1] == '\r') eol[-1] = 0;
+		++nlines;
+		if (*p) {
+			name = p;
+			f = p + strcspn(p, "\t");
+			if (*f) *f++ = 0;
+			if (!*name) fail("%s line %d has no sample name", fmf_path, nlines);
+			for (j = 0; j < n && strcmp(names[j], name); ++j);
+			if (j == n) fail("%s line %d: %s is not a sample of this database", fmf_path, nlines, name);
+			if (meta[j]) fail("%s line %d: %s is there twice", fmf_path, nlines, name);
+			meta[j] = f;
+			while (*f) {
+				char *next = f + strcspn(f, "\t");
+				int end = !*next;
+				*next = 0;
+				if (!valid_meta(f)) fail("%s line %d: %s is not key:type:value with type Z, f or i", fmf_path, nlines, f);
+				if (!end) *next = '\t';
+				f = end ? next : next + 1;
+			}
+		}
+		if (last) break;
+		p = eol + 1;
+	}
+
+	for (j = 0; j < n; ++j) total += strlen(names[j]) + (meta[j] ? strlen(meta[j]) + 1 : 0) + 1;
+	line = xmalloc(total + 1);
+	for (p = line, j = 0; j < n; ++j)
+		p += sprintf(p, meta[j] && *meta[j] ? "%s\t%s\n" : "%s\n", names[j], meta[j] && *meta[j] ? meta[j] : "");
+
+	for (j = 0; members[j]; ++j) {
+		char name[64];
+		snprintf(name, sizeof name, OUT_PREFIX "%s", members[j] + 3);
+		if (j == 3) write_file(name, line, p - line);
+		else write_file(name, s.data[j], s.size[j]);
+	}
+	tar_write(out_path, OUT_PREFIX);
+}
+
+/* ---- entry point ---- */
+
+static void remove_store(const char *prefix)
+{
+	int i;
+	for (i = 0; members[i]; ++i) {
+		char name[64];
+		snprintf(name, sizeof name, "%s%s", prefix, members[i] + 3);
+		unlink(name);
+	}
+}
+
+static void remove_all(void)
+{
+	int i;
+	char prefix[32];
+	remove_store(OUT_PREFIX);
+	for (i = 0; i < MAX_STORES; ++i) {
+		snprintf(prefix, sizeof prefix, OUT_PREFIX "%d", i + 1);
+		remove_store(prefix);
+	}
+}
+
+/* --bc-bgt FILE   a database to read; the operation gets its prefix
+ *                 after its other arguments (view, getalt), or its
+ *                 sample list (fmf)
+ * --bc-fmf FILE   with fmf: the FMF file to read, before the condition
+ * --bc-out FILE   import writes the database here
+ * --bc-to FILE    standard output goes to this file (BCF)
+ * --bc-meta FILE  with the subcommand "samples": the metadata to set */
+int main(int argc, char *argv[])
+{
+	char **args = calloc(argc + MAX_STORES + 2, sizeof(char *));
+	const char *stores[MAX_STORES], *out = NULL, *meta = NULL, *fmf = NULL, *to = NULL;
+	static char prefixes[MAX_STORES][32], spl[40];
+	int i, n = 0, nstores = 0, out_at = -1, rc;
+
+	if (!args) fail("out of memory");
+	/* Working files, of this run or one before it in the same file system */
+	remove_all();
+	if (atexit(remove_all)) fail("cannot register the clean-up");
+	for (i = 0; i < MAX_STORES; ++i) snprintf(prefixes[i], sizeof prefixes[i], OUT_PREFIX "%d", i + 1);
+
+	args[n++] = argv[0];
+	for (i = 1; i < argc; ++i) {
+		const char *a = argv[i];
+		if (strcmp(a, "--bc-bgt") && strcmp(a, "--bc-out") && strcmp(a, "--bc-meta") && strcmp(a, "--bc-fmf")
+		    && strcmp(a, "--bc-to")) {
+			args[n++] = argv[i];
+			continue;
+		}
+		if (i + 1 >= argc) fail("%s needs a file", a);
+		if (!strcmp(a, "--bc-bgt")) {
+			if (nstores == MAX_STORES) fail("at most %d databases", MAX_STORES);
+			stores[nstores++] = argv[++i];
+		} else if (!strcmp(a, "--bc-out")) {
+			if (out) fail("--bc-out given twice");
+			out = argv[++i];
+			out_at = n;
+		} else if (!strcmp(a, "--bc-to")) {
+			if (to) fail("--bc-to given twice");
+			to = argv[++i];
+		} else if (!strcmp(a, "--bc-fmf")) {
+			if (fmf) fail("--bc-fmf given twice");
+			fmf = argv[++i];
+		} else {
+			if (meta) fail("--bc-meta given twice");
+			meta = argv[++i];
+		}
+	}
+	args[n] = NULL;
+
+	if (n >= 2 && !strcmp(args[1], "samples")) {
+		if (n != 2 || nstores != 1 || !meta || !out || fmf) fail("samples takes --bc-bgt, --bc-meta and --bc-out only");
+		set_samples(stores[0], meta, out);
+		return 0;
+	}
+	if (meta) fail("--bc-meta goes with samples only");
+	if (to && out) fail("--bc-to and --bc-out do not go together");
+	if (to && !freopen(to, "wb", stdout)) fail("cannot write %s", to);
+
+	if (out) {
+		/* import: the prefix goes where the output was given, before the inputs */
+		if (n < 2 || strcmp(args[1], "import") || nstores) fail("--bc-out goes with import only");
+		memmove(args + out_at + 1, args + out_at, (n - out_at + 1) * sizeof(char *));
+		args[out_at] = OUT_PREFIX;
+		++n;
+		rc = bgt_main(n, args);
+		if (rc == 0) tar_write(out, OUT_PREFIX);
+		return rc;
+	}
+
+	for (i = 0; i < nstores; ++i) unpack(stores[i], prefixes[i]);
+	if (n >= 2 && !strcmp(args[1], "fmf")) {
+		const char *file = fmf;
+		if (nstores + !!fmf != 1) fail("fmf reads one database or one FMF file");
+		if (nstores) {
+			snprintf(spl, sizeof spl, "%s.spl", prefixes[0]);
+			file = spl;
+		}
+		/* the file goes before an optional condition */
+		for (i = 2; i < n && args[i][0] == '-' && args[i][1]; ++i);
+		memmove(args + i + 1, args + i, (n - i + 1) * sizeof(char *));
+		args[i] = (char *)file;
+		++n;
+	} else if (fmf) {
+		fail("--bc-fmf goes with fmf only");
+	} else if (nstores) {
+		if (n < 2 || (strcmp(args[1], "view") && strcmp(args[1], "getalt"))) fail("--bc-bgt goes with view, getalt or fmf");
+		if (!strcmp(args[1], "getalt") && nstores != 1) fail("getalt reads one database");
+		for (i = 0; i < nstores; ++i) args[n++] = prefixes[i];
+		args[n] = NULL;
+	}
+	return bgt_main(n, args);
+}
