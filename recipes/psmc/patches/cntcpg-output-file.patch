cntcpg writes binary counts to stdout, and BioChef reads stdout as text, so
give it an output file (-o) to write them to instead.

diff --git a/utils/cntcpg.c b/utils/cntcpg.c
index 1c2a254..4b98c05 100644
--- a/utils/cntcpg.c
+++ b/utils/cntcpg.c
@@ -37,9 +37,10 @@ int main(int argc, char *argv[])
 	kseq_t *seq;
 	int32_t l, c, step = 100, bin = 0;
 	double n_ratio = 0.9;
-	while ((c = getopt(argc, argv, "s:n:b")) >= 0) {
+	while ((c = getopt(argc, argv, "s:n:bo:")) >= 0) {
 		switch (c) {
 		case 'b': bin = 1; break;
+		case 'o': if (freopen(optarg, "wb", stdout) == 0) return 2; break;
 		case 's': step = atoi(optarg); break;
 		case 'n': n_ratio = atof(optarg); break;
 		}
