An existing alignment with no gap characters and sequences of one length is
read as ALN_STATUS_UNKNOWN, which has the same value (3) as ALN_STATUS_FINAL,
so --add took it as finalised with alnlen 0 and read before the start of a
buffer. Its sequences are kept as they are, so its length is that of its
sequences, as msa_cmp.c already assumes; sequences of different lengths are
an error.

diff --git a/lib/src/aln_add.c b/lib/src/aln_add.c
index e9b96b7..1ba5d43 100644
--- a/lib/src/aln_add.c
+++ b/lib/src/aln_add.c
@@ -296,6 +296,15 @@ int kalign_add_sequences(struct msa* existing,
         numseq_existing = existing->numseq;
         numseq_new = new_seqs->numseq;
         alnlen = existing->alnlen;
+        if(alnlen == 0 && numseq_existing > 0){
+                alnlen = existing->sequences[0]->len;
+                for(i = 1; i < numseq_existing; i++){
+                        if(existing->sequences[i]->len != alnlen){
+                                ERROR_MSG("Existing MSA must be aligned");
+                        }
+                }
+                existing->alnlen = alnlen;
+        }
 
         if(numseq_new == 0){
                 return OK;  /* nothing to add */
