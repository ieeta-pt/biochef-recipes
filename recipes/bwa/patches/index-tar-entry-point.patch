BioChef passes the index between operations as one tar. This entry point,
linked in place of bwa's own main, writes that tar after bwa index, and
checks and unpacks it before the operations that read an index.

diff --git a/biochef_main.c b/biochef_main.c
new file mode 100644
index 0000000..855308e
--- /dev/null
+++ b/biochef_main.c
@@ -0,0 +1,455 @@
+#include <limits.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+int bwa_main(int argc, char *argv[]);
+
+/* A bwa index is five files sharing a prefix, and a sixth, .alt, when some
+ * sequences are alternate contigs. Between operations it travels as one tar
+ * holding them under the prefix "ref", so that a single input carries the
+ * whole index and it can be unpacked outside BioChef. */
+enum { AMB, ANN, BWT, PAC, SA, ALT, N_MEMBERS };
+static const char *members[] = { "ref.amb", "ref.ann", "ref.bwt", "ref.pac", "ref.sa", "ref.alt", NULL };
+#define OPTIONAL (1 << ALT)
+#define PREFIX "_bc_bwa"
+
+static void fail(const char *format, ...) __attribute__((noreturn, format(printf, 1, 2)));
+static void fail(const char *format, ...)
+{
+	va_list ap;
+	fputs("[bwa] ", stderr);
+	va_start(ap, format);
+	vfprintf(stderr, format, ap);
+	va_end(ap);
+	fputc('\n', stderr);
+	exit(1);
+}
+
+static void *xmalloc(size_t size)
+{
+	void *p = malloc(size ? size : 1);
+	if (!p) fail("out of memory");
+	return p;
+}
+
+static unsigned char *read_file(const char *path, long *size)
+{
+	FILE *fp = fopen(path, "rb");
+	unsigned char *buf;
+	if (!fp) fail("cannot read %s", path);
+	if (fseek(fp, 0, SEEK_END) || (*size = ftell(fp)) < 0 || fseek(fp, 0, SEEK_SET)) fail("cannot read %s", path);
+	buf = xmalloc(*size + 1);
+	if (fread(buf, 1, *size, fp) != (size_t)*size) fail("cannot read %s", path);
+	buf[*size] = 0;
+	fclose(fp);
+	return buf;
+}
+
+static void write_file(const char *path, const void *data, long size)
+{
+	FILE *fp = fopen(path, "wb");
+	if (!fp || fwrite(data, 1, size, fp) != (size_t)size || fclose(fp)) fail("cannot write %s", path);
+}
+
+static const char *member_file(int i)
+{
+	static char name[64];
+	snprintf(name, sizeof name, PREFIX "%s", members[i] + 3);
+	return name;
+}
+
+/* ---- tar (POSIX ustar), only regular files ---- */
+
+static unsigned tar_checksum(const unsigned char *h)
+{
+	unsigned sum = 0;
+	int i;
+	for (i = 0; i < 512; ++i) sum += (i >= 148 && i < 156) ? ' ' : h[i];
+	return sum;
+}
+
+/* Writes the index files that exist as a tar with fixed owner, mode and
+ * time, so the same index always gives the same bytes. */
+static void tar_write(const char *path)
+{
+	FILE *out = fopen(path, "wb");
+	static unsigned char zero[1024];
+	int i;
+	if (!out) fail("cannot write %s", path);
+	for (i = 0; members[i]; ++i) {
+		unsigned char h[512];
+		long size, pad;
+		unsigned char *data;
+		if ((OPTIONAL & 1 << i) && access(member_file(i), F_OK)) continue;
+		data = read_file(member_file(i), &size);
+		memset(h, 0, sizeof h);
+		memcpy(h, members[i], strlen(members[i]));
+		memcpy(h + 100, "0000644", 7);
+		memcpy(h + 108, "0000000", 7);
+		memcpy(h + 116, "0000000", 7);
+		snprintf((char *)h + 124, 12, "%011lo", size);
+		memcpy(h + 136, "00000000000", 11);
+		h[156] = '0';
+		memcpy(h + 257, "ustar", 6);
+		memcpy(h + 263, "00", 2);
+		snprintf((char *)h + 148, 8, "%06o", tar_checksum(h));
+		h[155] = ' ';
+		pad = (512 - size % 512) % 512;
+		if (fwrite(h, 1, 512, out) != 512 || fwrite(data, 1, size, out) != (size_t)size
+		    || fwrite(zero, 1, pad, out) != (size_t)pad)
+			fail("cannot write %s", path);
+		free(data);
+	}
+	if (fwrite(zero, 1, 1024, out) != 1024 || fclose(out)) fail("cannot write %s", path);
+}
+
+static long octal(const unsigned char *p, int len, const char *path)
+{
+	long v = 0;
+	int i = 0;
+	while (i < len && p[i] == ' ') ++i;
+	if (i == len || p[i] < '0' || p[i] > '7') fail("%s is not a bwa index: a broken tar header", path);
+	for (; i < len && p[i] >= '0' && p[i] <= '7'; ++i) {
+		if (v > (LONG_MAX - 7) / 8) fail("%s is not a bwa index: a member is too large", path);
+		v = v * 8 + (p[i] - '0');
+	}
+	for (; i < len; ++i)
+		if (p[i] != ' ' && p[i] != 0) fail("%s is not a bwa index: a broken tar header", path);
+	return v;
+}
+
+/* A pax header (typeflag x or g) may carry attributes such as times or
+ * extended attributes, which do not matter here. One that renames the next
+ * member or changes its size would make it a different file: refused. */
+static void check_pax(const unsigned char *p, long len, const char *path)
+{
+	const unsigned char *end = p + len;
+	while (p < end && *p) {
+		long n = 0;
+		const unsigned char *q = p, *key;
+		while (q < end && *q >= '0' && *q <= '9' && n < len) n = n * 10 + (*q++ - '0');
+		if (q == p || q >= end || *q != ' ' || n <= q - p + 1 || n > end - p || p[n - 1] != '\n')
+			fail("%s is not a bwa index: a broken pax header", path);
+		key = q + 1;
+		if (!strncmp((const char *)key, "path=", 5) || !strncmp((const char *)key, "linkpath=", 9)
+		    || !strncmp((const char *)key, "size=", 5) || !strncmp((const char *)key, "GNU.sparse", 10))
+			fail("%s is not a bwa index: a pax header changes a member", path);
+		p += n;
+	}
+}
+
+struct index { const unsigned char *data[N_MEMBERS]; long size[N_MEMBERS]; unsigned char *buf; int found; };
+
+/* Reads a tar that must hold the five index files, and may hold .alt, each
+ * once, as regular files. Nothing in it names a path. */
+static void tar_read(const char *path, struct index *x)
+{
+	long size, off = 0;
+	int i;
+	memset(x, 0, sizeof *x);
+	x->buf = read_file(path, &size);
+	for (;;) {
+		const unsigned char *h = x->buf + off;
+		long len;
+		if (off + 512 > size) fail("%s is not a bwa index: it ends inside a tar header", path);
+		for (i = 0; i < 512 && !h[i]; ++i);
+		if (i == 512) break;
+		if (memcmp(h + 257, "ustar", 5)) fail("%s is not a bwa index: not a tar file", path);
+		if (octal(h + 148, 8, path) != (long)tar_checksum(h)) fail("%s is not a bwa index: a tar header checksum is wrong", path);
+		len = octal(h + 124, 12, path);
+		if (len > size - off - 512) fail("%s is not a bwa index: %.100s is cut short", path, (const char *)h);
+		if (h[156] == 'x' || h[156] == 'g') {
+			check_pax(h + 512, len, path);
+			off += 512 + (len + 511) / 512 * 512;
+			continue;
+		}
+		if (h[156] != '0' && h[156] != 0) fail("%s is not a bwa index: it holds something other than files", path);
+		if (h[345]) fail("%s is not a bwa index: a member has a path", path);
+		/* macOS tar adds the extended attributes of a file as ._file */
+		for (i = 0; members[i]; ++i)
+			if (!strncmp((const char *)h, "._", 2) && !strncmp((const char *)h + 2, members[i], 98) && !h[2 + strlen(members[i])]) break;
+		if (members[i]) {
+			off += 512 + (len + 511) / 512 * 512;
+			continue;
+		}
+		for (i = 0; members[i]; ++i)
+			if (!strncmp((const char *)h, members[i], 100) && !h[strlen(members[i])]) break;
+		if (!members[i]) fail("%s is not a bwa index: it holds %.100s", path, (const char *)h);
+		if (x->found & 1 << i) fail("%s is not a bwa index: it holds %s twice", path, members[i]);
+		x->found |= 1 << i;
+		x->data[i] = h + 512;
+		x->size[i] = len;
+		off += 512 + (len + 511) / 512 * 512;
+	}
+	for (i = 0; members[i]; ++i)
+		if (!(x->found & 1 << i) && !(OPTIONAL & 1 << i)) fail("%s is not a bwa index: it lacks %s", path, members[i]);
+}
+
+static uint32_t le32(const unsigned char *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t le64(const unsigned char *p)
+{
+	uint64_t v = 0;
+	int i;
+	for (i = 7; i >= 0; --i) v = v << 8 | p[i];
+	return v;
+}
+
+/* The first line of .ann and .amb: the reference length and the number of
+ * sequences, then the seed (.ann) or the number of holes (.amb). */
+static void first_line(const struct index *x, int i, long long *len, int *n, const char *path)
+{
+	char line[128];
+	long k = x->size[i] < (long)sizeof line - 1 ? x->size[i] : (long)sizeof line - 1;
+	unsigned third;
+	memcpy(line, x->data[i], k);
+	line[k] = 0;
+	if (sscanf(line, "%lld %d %u", len, n, &third) != 3 || *len < 1 || *n < 1)
+		fail("%s is not a bwa index: %s does not start with its sizes", path, members[i]);
+}
+
+/* The files must belong together, as bwa assumes when it reads them: the
+ * sequence lengths in .ann, .amb and .pac agree, .bwt holds the BWT of both
+ * strands of that sequence, and .sa was sampled from that BWT. */
+static void check_index(const struct index *x, const char *path)
+{
+	long long l_pac, l_amb;
+	int n_seqs, n_amb, i;
+	uint64_t seq_len, intv, n_occ;
+	const unsigned char *bwt = x->data[BWT], *sa = x->data[SA];
+
+	first_line(x, ANN, &l_pac, &n_seqs, path);
+	first_line(x, AMB, &l_amb, &n_amb, path);
+	if (l_amb != l_pac || n_amb != n_seqs) fail("%s is not a bwa index: ref.ann and ref.amb describe different sequences", path);
+	if (x->size[PAC] != l_pac / 4 + 2) fail("%s is not a bwa index: ref.pac does not hold %lld bases", path, l_pac);
+
+	if (x->size[BWT] < 40) fail("%s is not a bwa index: ref.bwt is cut short", path);
+	seq_len = le64(bwt + 32);
+	if (seq_len != 2 * (uint64_t)l_pac) fail("%s is not a bwa index: ref.bwt is not of these sequences", path);
+	for (i = 0; i < 3; ++i)
+		if (le64(bwt + 8 + 8 * i) > le64(bwt + 16 + 8 * i)) fail("%s is not a bwa index: ref.bwt has broken counts", path);
+	if (le64(bwt) > seq_len) fail("%s is not a bwa index: ref.bwt has broken counts", path);
+	n_occ = (seq_len + 127) / 128 + 1;
+	if ((uint64_t)x->size[BWT] != 40 + 4 * ((seq_len + 15) / 16 + 8 * n_occ))
+		fail("%s is not a bwa index: ref.bwt is not %llu bases long", path, (unsigned long long)seq_len);
+
+	if (x->size[SA] < 56 || memcmp(sa, bwt, 40)) fail("%s is not a bwa index: ref.sa is not of ref.bwt", path);
+	/* bwa reads the sampling interval as an int from the first half of its
+	 * 8 bytes */
+	intv = le32(sa + 40);
+	if (intv < 1 || intv > INT_MAX || le64(sa + 48) != seq_len || (uint64_t)x->size[SA] != 56 + 8 * ((seq_len + intv) / intv - 1))
+		fail("%s is not a bwa index: ref.sa is not of ref.bwt", path);
+
+	if (x->found & 1 << ALT)
+		for (i = 0; i < x->size[ALT]; ++i)
+			if (!x->data[ALT][i]) fail("%s is not a bwa index: ref.alt is not text", path);
+}
+
+/* FNV-1a, to name an index and a reads file by their contents */
+static uint64_t fnv(uint64_t h, const unsigned char *p, long n)
+{
+	long i;
+	for (i = 0; i < n; ++i) h = (h ^ p[i]) * 1099511628211ULL;
+	return h;
+}
+#define FNV_START 14695981039346656037ULL
+
+static uint64_t file_hash(const char *path)
+{
+	long size;
+	unsigned char *data = read_file(path, &size);
+	uint64_t h = fnv(FNV_START, data, size);
+	free(data);
+	return h;
+}
+
+/* The sequences of the index: its .ann, .amb and .pac */
+static uint64_t index_hash, index_seq_len;
+
+static void unpack(const char *path)
+{
+	struct index x;
+	int i;
+	tar_read(path, &x);
+	check_index(&x, path);
+	for (i = 0; members[i]; ++i)
+		if (x.found & 1 << i) write_file(member_file(i), x.data[i], x.size[i]);
+	index_hash = fnv(fnv(fnv(FNV_START, x.data[ANN], x.size[ANN]), x.data[AMB], x.size[AMB]), x.data[PAC], x.size[PAC]);
+	index_seq_len = le64(x.data[BWT] + 32);
+	free(x.buf);
+}
+
+/* ---- SAI ---- */
+
+/* An SAI file is "SAI\1", bwa aln's options (gap_opt_t, 16 4-byte fields),
+ * then for each read the number of its alignments and those alignments
+ * (bwt_aln1_t: 8 bytes of counts, then the suffix array interval k, l).
+ * aln here adds a trailer naming the index and the reads it was made from:
+ * their hashes, then "BIOCHEF\1". bwa reads one record per read and stops,
+ * so it never reads the trailer. */
+#define SAI_HEADER (4 + 16 * 4)
+#define SAI_ALN 24
+#define TRAILER 24
+static const char trailer_magic[] = "BIOCHEF\1";
+
+/* The length of the records of an SAI held in data[0..size), or -1 when
+ * they do not fill it exactly. Every interval must lie in the index. */
+static long sai_records(const unsigned char *data, long size, uint64_t seq_len)
+{
+	long off = SAI_HEADER;
+	while (off < size) {
+		long i, n;
+		if (size - off < 4) return -1;
+		n = (long)le32(data + off);
+		off += 4;
+		if (n < 0 || n > (size - off) / SAI_ALN) return -1;
+		for (i = 0; i < n; ++i, off += SAI_ALN)
+			if (le64(data + off + 8) > seq_len || le64(data + off + 16) > seq_len) return -2;
+	}
+	return off;
+}
+
+/* Checks an SAI given with the reads it is to be read with, and writes
+ * it without its trailer to a working file, whose name it returns. */
+static const char *take_sai(const char *path, const char *reads, int k)
+{
+	static char names[2][32];
+	long size, end;
+	unsigned char *data = read_file(path, &size);
+	if (size < SAI_HEADER || memcmp(data, "SAI\1", 4)) fail("%s is not an SAI file from bwa aln", path);
+	end = sai_records(data, size, index_seq_len);
+	if (end != size) {
+		/* with a trailer, the records end where it begins */
+		if (size >= SAI_HEADER + TRAILER && !memcmp(data + size - 8, trailer_magic, 8)
+		    && sai_records(data, size - TRAILER, index_seq_len) == size - TRAILER) {
+			if (le64(data + size - TRAILER) != index_hash)
+				fail("%s was made with another index", path);
+			if (le64(data + size - TRAILER + 8) != file_hash(reads))
+				fail("%s was made from other reads than %s", path, reads);
+			size -= TRAILER;
+		} else if (end == -2 || sai_records(data, size - TRAILER, index_seq_len) == -2) {
+			fail("%s holds alignments outside this index", path);
+		} else {
+			fail("%s is not an SAI file from bwa aln", path);
+		}
+	}
+	snprintf(names[k], sizeof names[k], PREFIX "%d.sai", k + 1);
+	write_file(names[k], data, size);
+	free(data);
+	return names[k];
+}
+
+static void append_trailer(const char *path, const char *reads)
+{
+	unsigned char t[TRAILER];
+	uint64_t v[2];
+	int i, j;
+	FILE *fp;
+	v[0] = index_hash;
+	v[1] = file_hash(reads);
+	for (j = 0; j < 2; ++j)
+		for (i = 0; i < 8; ++i) t[8 * j + i] = v[j] >> 8 * i & 0xff;
+	memcpy(t + 16, trailer_magic, 8);
+	if (!(fp = fopen(path, "ab")) || fwrite(t, 1, TRAILER, fp) != TRAILER || fclose(fp)) fail("cannot write %s", path);
+}
+
+static void remove_index(void)
+{
+	int i;
+	for (i = 0; members[i]; ++i) unlink(member_file(i));
+	unlink(PREFIX "1.sai");
+	unlink(PREFIX "2.sai");
+}
+
+/* --bc-index FILE  an index to read: its prefix takes the place of the
+ *                  option, which comes after the other options
+ * --bc-out FILE    index writes the index here
+ * --bc-alt FILE    with index: the alternate contigs (the .alt file)
+ * --bc-to FILE     standard output goes to this file (aln's SAI)
+ *
+ * aln marks its SAI with the index and the reads; samse and sampe check
+ * each SAI against theirs. */
+int main(int argc, char *argv[])
+{
+	char **args = calloc(argc + 3, sizeof(char *));
+	const char *index = NULL, *out = NULL, *alt = NULL, *to = NULL;
+	int i, n = 0, index_at = -1, rc;
+
+	if (!args) fail("out of memory");
+	/* Working files, of this run or one before it in the same file system */
+	remove_index();
+	if (atexit(remove_index)) fail("cannot register the clean-up");
+
+	args[n++] = argv[0];
+	for (i = 1; i < argc; ++i) {
+		const char *a = argv[i], **slot;
+		if (!strcmp(a, "--bc-index")) slot = &index;
+		else if (!strcmp(a, "--bc-out")) slot = &out;
+		else if (!strcmp(a, "--bc-alt")) slot = &alt;
+		else if (!strcmp(a, "--bc-to")) slot = &to;
+		else {
+			args[n++] = argv[i];
+			continue;
+		}
+		if (i + 1 >= argc) fail("%s needs a file", a);
+		if (*slot) fail("%s given twice", a);
+		*slot = argv[++i];
+		if (slot == &index) index_at = n;
+	}
+	args[n] = NULL;
+	if (n < 2) return bwa_main(n, args);
+
+	if (to && !freopen(to, "wb", stdout)) fail("cannot write %s", to);
+
+	if (out) {
+		/* index: -p names the files, and the tar is written once all are */
+		if (strcmp(args[1], "index") || index) fail("--bc-out goes with index only");
+		memmove(args + 4, args + 2, (n - 1) * sizeof(char *));
+		args[2] = "-p";
+		args[3] = PREFIX;
+		n += 2;
+		rc = bwa_main(n, args);
+		if (rc != 0) return rc;
+		if (alt) {
+			long size;
+			unsigned char *data = read_file(alt, &size);
+			if (memchr(data, 0, size)) fail("%s is not text", alt);
+			write_file(member_file(ALT), data, size);
+			free(data);
+		}
+		tar_write(out);
+		return 0;
+	}
+	if (alt) fail("--bc-alt goes with index only");
+
+	if (index) {
+		unpack(index);
+		memmove(args + index_at + 1, args + index_at, (n - index_at + 1) * sizeof(char *));
+		args[index_at] = PREFIX;
+		++n;
+		/* bwa reads options up to the first other argument: none may follow */
+		for (i = index_at + 1; i < n; ++i)
+			if (args[i][0] == '-' && args[i][1]) fail("option %s comes after the index", args[i]);
+		if (!strcmp(args[1], "samse")) {
+			if (n - index_at != 3) fail("samse takes an index, an SAI and reads");
+			args[index_at + 1] = (char *)take_sai(args[index_at + 1], args[index_at + 2], 0);
+		} else if (!strcmp(args[1], "sampe")) {
+			if (n - index_at != 5) fail("sampe takes an index, two SAI and two reads files");
+			args[index_at + 1] = (char *)take_sai(args[index_at + 1], args[index_at + 3], 0);
+			args[index_at + 2] = (char *)take_sai(args[index_at + 2], args[index_at + 4], 1);
+		} else if (!strcmp(args[1], "aln") && to) {
+			if (n - index_at != 2) fail("aln takes an index and reads");
+			rc = bwa_main(n, args);
+			if (rc == 0) append_trailer(to, args[n - 1]);
+			return rc;
+		}
+	}
+	return bwa_main(n, args);
+}
