Bifrost seeded its Bloom filter and colour hashes from std::random_device,
so the same transcripts gave another index in every run. The seeds are now
fixed, and drawn from mt19937_64 itself: std::uniform_int_distribution and
std::default_random_engine are the C++ library's own, and libstdc++, here,
and libc++, in wasm, give other numbers from them.

diff --git a/ext/bifrost/src/BlockedBloomFilter.cpp b/ext/bifrost/src/BlockedBloomFilter.cpp
index f13e2dc..4b1c4c9 100755
--- a/ext/bifrost/src/BlockedBloomFilter.cpp
+++ b/ext/bifrost/src/BlockedBloomFilter.cpp
@@ -12,7 +12,7 @@ BlockedBloomFilter::BlockedBloomFilter(size_t nb_elem, size_t bits_per_elem) : t
     if ((nb_elem != 0) && (bits_per_elem != 0)){
 
         std::random_device rd;
-        std::mt19937_64 gen(rd());
+        std::mt19937_64 gen(42);
         std::uniform_int_distribution<unsigned long long> distribution;
 
         blocks_ = (bits_per_elem * nb_elem + MASK_BITS_BLOCK) / NB_BITS_BLOCK;
@@ -20,8 +20,8 @@ BlockedBloomFilter::BlockedBloomFilter(size_t nb_elem, size_t bits_per_elem) : t
 
         if (fpp(bits_per_elem, k_) >= fpp(bits_per_elem, k_+1)) ++k_;
 
-        seed1 = distribution(gen);
-        seed2 = distribution(gen);
+        seed1 = gen();
+        seed2 = gen();
 
         init_arrays();
     }
